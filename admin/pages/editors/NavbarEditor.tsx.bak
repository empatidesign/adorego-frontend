import React, { useState, useEffect } from 'react';
import AdminLayout from '../../components/Layout';
import { Input, Button, Select } from '../../components/forms/FormComponents';
import ImageUpload from '../../components/forms/ImageUpload';
import { contentAPI } from '../../services/api';

type Language = 'tr' | 'en';

interface MenuItem {
  id: string;
  labelTR: string;
  labelEN: string;
  href: string;
  parentId: string | null;
  position: 'header' | 'footer';
  order: number;
  isActive: boolean;
  mobileVisible: boolean;
}

interface CTAButton {
  id: string;
  labelTR: string;
  labelEN: string;
  href: string;
  variant: 'primary' | 'secondary';
}

// Default menu structure
const DEFAULT_MENU_ITEMS: MenuItem[] = [
  // Header
  { id: '1', labelTR: 'Ana Sayfa', labelEN: 'Home', href: '/', parentId: null, position: 'header', order: 0, isActive: true, mobileVisible: true },
  { id: '2', labelTR: 'Fiyat Hesapla', labelEN: 'Calculate Price', href: '/fiyatlar', parentId: null, position: 'header', order: 1, isActive: true, mobileVisible: true },
  { id: '3', labelTR: 'Gönderi Takibi', labelEN: 'Track Shipment', href: '/gonderi-takibi', parentId: null, position: 'header', order: 2, isActive: true, mobileVisible: true },

  // Footer - Hizmetlerimiz
  { id: '100', labelTR: '1-Hizmetlerimiz', labelEN: '1-Our Services', href: '#', parentId: null, position: 'footer', order: 0, isActive: true, mobileVisible: true },
  { id: '101', labelTR: 'Yurtdışı Kargo', labelEN: 'International Shipping', href: '#yurtdisi', parentId: '100', position: 'footer', order: 0, isActive: true, mobileVisible: true },
  { id: '102', labelTR: 'Ekonomik Kargo', labelEN: 'Economy Shipping', href: '#yurtdisi', parentId: '100', position: 'footer', order: 1, isActive: true, mobileVisible: true },
  { id: '103', labelTR: 'Express Kargo', labelEN: 'Express Shipping', href: '#yurtdisi', parentId: '100', position: 'footer', order: 2, isActive: true, mobileVisible: true },

  // Footer - Nasıl Çalışır
  { id: '200', labelTR: '2-Nasıl Çalışır?', labelEN: '2-How It Works?', href: '#', parentId: null, position: 'footer', order: 1, isActive: true, mobileVisible: true },
  { id: '201', labelTR: 'Nasıl Gönderirim?', labelEN: 'How to Ship?', href: '#nasil-calisir', parentId: '200', position: 'footer', order: 0, isActive: true, mobileVisible: true },
  { id: '202', labelTR: 'Kapıdan Alım – Teslim', labelEN: 'Door to Door', href: '#nasil-calisir', parentId: '200', position: 'footer', order: 1, isActive: true, mobileVisible: true },

  // Footer - Bilgi & Kaynaklar
  { id: '300', labelTR: '3-Bilgi & Kaynaklar', labelEN: '3-Info & Resources', href: '#', parentId: null, position: 'footer', order: 2, isActive: true, mobileVisible: true },
  { id: '301', labelTR: 'Sıkça Sorulan Sorular', labelEN: 'FAQ', href: '#sss', parentId: '300', position: 'footer', order: 0, isActive: true, mobileVisible: true },
  { id: '302', labelTR: 'Lojistik Blog', labelEN: 'Logistics Blog', href: '#', parentId: '300', position: 'footer', order: 1, isActive: true, mobileVisible: true },

  // Footer - Entegrasyonlar
  { id: '400', labelTR: '4-Entegrasyonlar', labelEN: '4-Integrations', href: '#', parentId: null, position: 'footer', order: 3, isActive: true, mobileVisible: true },
  { id: '401', labelTR: 'Shopify Entegrasyonu', labelEN: 'Shopify Integration', href: '#', parentId: '400', position: 'footer', order: 0, isActive: true, mobileVisible: true },
  { id: '402', labelTR: 'WooCommerce', labelEN: 'WooCommerce', href: '#', parentId: '400', position: 'footer', order: 1, isActive: true, mobileVisible: true },
];

const DEFAULT_CTA_BUTTONS: CTAButton[] = [
  { id: '1', labelTR: 'PANEL', labelEN: 'PANEL', href: '/admin', variant: 'secondary' },
  { id: '2', labelTR: 'ÜYE OL', labelEN: 'SIGN UP', href: '#signup', variant: 'primary' },
];

const NavbarEditor: React.FC = () => {
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState({ type: '', text: '' });
  const [editingItem, setEditingItem] = useState<MenuItem | null>(null);
  const [showEditForm, setShowEditForm] = useState(false);
  const [editLang, setEditLang] = useState<Language>('tr');

  const [menuItems, setMenuItems] = useState<MenuItem[]>(DEFAULT_MENU_ITEMS);
  const [ctaButtons, setCtaButtons] = useState<CTAButton[]>(DEFAULT_CTA_BUTTONS);

  useEffect(() => {
    loadData();
  }, []);

  const loadData = async () => {
    try {
      console.log('Loading navbar data...');
      const dataTR = await contentAPI.getNavbar('tr');
      const dataEN = await contentAPI.getNavbar('en');

      console.log('Data TR:', dataTR);
      console.log('Data EN:', dataEN);

      const itemsTR = Array.isArray(dataTR?.menuItems) ? dataTR.menuItems : [];
      const itemsEN = Array.isArray(dataEN?.menuItems) ? dataEN.menuItems : [];

      console.log('Items TR length:', itemsTR.length);
      console.log('Items EN length:', itemsEN.length);

      if (itemsTR.length > 0) {
        const merged = itemsTR.map((itemTR: any) => {
          const itemEN = itemsEN.find((en: any) => en.id === itemTR.id);
          return {
            ...itemTR,
            labelTR: itemTR.label || '',
            labelEN: itemEN?.label || '',
            isActive: itemTR.isActive !== false,
            mobileVisible: itemTR.mobileVisible !== false
          };
        });
        console.log('Setting merged items:', merged);
        setMenuItems(merged);
      } else {
        console.log('No items from API, keeping default menus');
      }
    } catch (error) {
      console.error('Menü yüklenemedi:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleSave = async () => {
    setSaving(true);
    setMessage({ type: '', text: '' });

    try {
      const menuItemsTR = menuItems.map(item => ({ ...item, label: item.labelTR }));
      const menuItemsEN = menuItems.map(item => ({ ...item, label: item.labelEN }));

      await contentAPI.updateNavbar({ menuItems: menuItemsTR, ctaButtons }, 'tr');
      await contentAPI.updateNavbar({ menuItems: menuItemsEN, ctaButtons }, 'en');

      setMessage({ type: 'success', text: 'Menü başarıyla güncellendi!' });
    } catch (error: any) {
      setMessage({ type: 'error', text: error.response?.data?.message || 'Güncelleme başarısız' });
    } finally {
      setSaving(false);
    }
  };

  const addNewItem = () => {
    const newItem: MenuItem = {
      id: Date.now().toString(),
      labelTR: '',
      labelEN: '',
      href: '',
      parentId: null,
      position: 'header',
      order: menuItems.length,
      isActive: true,
      mobileVisible: true
    };
    setEditingItem(newItem);
    setEditLang('tr');
    setShowEditForm(true);
  };

  const editItem = (item: MenuItem) => {
    setEditingItem({ ...item });
    setEditLang('tr');
    setShowEditForm(true);
  };

  const saveEditingItem = () => {
    if (!editingItem) return;

    const isNew = !menuItems.find(item => item.id === editingItem.id);

    if (isNew) {
      setMenuItems([...menuItems, editingItem]);
    } else {
      setMenuItems(menuItems.map(item =>
        item.id === editingItem.id ? editingItem : item
      ));
    }

    setShowEditForm(false);
    setEditingItem(null);
  };

  const deleteItem = (id: string) => {
    if (confirm('Bu menü öğesini silmek istediğinizden emin misiniz?')) {
      setMenuItems(menuItems.filter(item => item.id !== id));
    }
  };

  const getParentMenuItems = () => {
    return menuItems.filter(item => item.parentId === null);
  };

  const getChildMenuItems = (parentId: string) => {
    return menuItems.filter(item => item.parentId === parentId);
  };

  return (
    <AdminLayout>
      <div className="max-w-7xl">
        <div className="flex items-center justify-between mb-8">
          <div>
            <h1 className="text-3xl font-bold text-gray-800">Menü Yönetimi</h1>
            <p className="text-gray-600 mt-1">Navbar ayarlarını ve menü öğelerini yönetin</p>
          </div>
          <Button onClick={addNewItem}>
            <i className="fas fa-plus mr-2"></i>
            Yeni Menü Ekle
          </Button>
        </div>

        {message.text && (
          <div className={`mb-6 p-4 rounded-lg ${message.type === 'success' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200'}`}>
            {message.text}
          </div>
        )}

        <div className="grid grid-cols-12 gap-6 mb-6">
          {/* Left Panel - Menu Tree */}
          <div className="col-span-4 bg-white rounded-xl shadow-sm p-6">
            <h3 className="font-bold text-gray-800 mb-4">Menü Yapısı</h3>
            <div className="space-y-2">
              {getParentMenuItems().map((parentItem) => (
                <div key={parentItem.id}>
                  <div className="flex items-center justify-between p-2 hover:bg-gray-50 rounded cursor-pointer">
                    <div className="flex items-center gap-2">
                      <i className="fas fa-bars text-gray-400"></i>
                      <span className="font-medium text-gray-700">{parentItem.labelTR}</span>
                    </div>
                    <div className="flex gap-1">
                      <button onClick={() => editItem(parentItem)} className="text-blue-600 hover:text-blue-700 text-sm px-2">
                        Düzenle
                      </button>
                      <button onClick={() => deleteItem(parentItem.id)} className="text-red-600 hover:text-red-700 text-sm px-2">
                        Sil
                      </button>
                    </div>
                  </div>
                  {getChildMenuItems(parentItem.id).map((childItem) => (
                    <div key={childItem.id} className="flex items-center justify-between p-2 pl-8 hover:bg-gray-50 rounded cursor-pointer">
                      <div className="flex items-center gap-2">
                        <i className="fas fa-minus text-gray-300 text-xs"></i>
                        <span className="text-gray-600">{childItem.labelTR}</span>
                      </div>
                      <div className="flex gap-1">
                        <button onClick={() => editItem(childItem)} className="text-blue-600 hover:text-blue-700 text-sm px-2">
                          Düzenle
                        </button>
                        <button onClick={() => deleteItem(childItem.id)} className="text-red-600 hover:text-red-700 text-sm px-2">
                          Sil
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>

          {/* Right Panel - Detailed Table */}
          <div className="col-span-8 bg-white rounded-xl shadow-sm overflow-hidden">
            <table className="w-full">
              <thead className="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th className="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase">Onay</th>
                  <th className="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase">Mobil Durum</th>
                  <th className="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase">Üst Menü</th>
                  <th className="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase">Menü Adı</th>
                  <th className="px-6 py-4 text-right text-xs font-bold text-gray-600 uppercase">İşlemler</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-200">
                {getParentMenuItems().map((parentItem) => (
                  <React.Fragment key={parentItem.id}>
                    <tr className="hover:bg-gray-50">
                      <td className="px-6 py-4">
                        <span className={`inline-flex items-center px-2 py-1 rounded text-xs font-medium ${parentItem.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600'}`}>
                          {parentItem.isActive ? 'Aktif' : 'Pasif'}
                        </span>
                      </td>
                      <td className="px-6 py-4">
                        <span className={`inline-flex items-center px-2 py-1 rounded text-xs font-medium ${parentItem.mobileVisible ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600'}`}>
                          {parentItem.mobileVisible ? 'Aktif' : 'Pasif'}
                        </span>
                      </td>
                      <td className="px-6 py-4 text-gray-500">-</td>
                      <td className="px-6 py-4">
                        <div className="font-medium text-gray-900">{parentItem.labelTR}</div>
                        <div className="text-sm text-gray-500">{parentItem.href}</div>
                      </td>
                      <td className="px-6 py-4 text-right">
                        <button onClick={() => editItem(parentItem)} className="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm mr-2">
                          <i className="fas fa-edit"></i>
                        </button>
                        <button onClick={() => deleteItem(parentItem.id)} className="px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-sm">
                          <i className="fas fa-trash"></i>
                        </button>
                      </td>
                    </tr>
                    {getChildMenuItems(parentItem.id).map((childItem) => (
                      <tr key={childItem.id} className="hover:bg-gray-50 bg-gray-25">
                        <td className="px-6 py-4">
                          <span className={`inline-flex items-center px-2 py-1 rounded text-xs font-medium ${childItem.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600'}`}>
                            {childItem.isActive ? 'Aktif' : 'Pasif'}
                          </span>
                        </td>
                        <td className="px-6 py-4">
                          <span className={`inline-flex items-center px-2 py-1 rounded text-xs font-medium ${childItem.mobileVisible ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600'}`}>
                            {childItem.mobileVisible ? 'Aktif' : 'Pasif'}
                          </span>
                        </td>
                        <td className="px-6 py-4 text-gray-600">{parentItem.labelTR}</td>
                        <td className="px-6 py-4">
                          <div className="font-medium text-gray-900 pl-6">↳ {childItem.labelTR}</div>
                          <div className="text-sm text-gray-500 pl-6">{childItem.href}</div>
                        </td>
                        <td className="px-6 py-4 text-right">
                          <button onClick={() => editItem(childItem)} className="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm mr-2">
                            <i className="fas fa-edit"></i>
                          </button>
                          <button onClick={() => deleteItem(childItem.id)} className="px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-sm">
                            <i className="fas fa-trash"></i>
                          </button>
                        </td>
                      </tr>
                    ))}
                  </React.Fragment>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Menu Edit Form Modal */}
        {showEditForm && editingItem && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-white rounded-xl shadow-2xl p-8 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
              <h2 className="text-2xl font-bold text-gray-800 mb-6">Menü Düzenle</h2>

              <div className="mb-6 flex gap-2">
                <button onClick={() => setEditLang('tr')} className={`px-6 py-2 rounded-lg font-bold ${editLang === 'tr' ? 'bg-blue-600 text-white shadow-md' : 'bg-gray-100 text-gray-600'}`}>
                  🇹🇷 TR
                </button>
                <button onClick={() => setEditLang('en')} className={`px-6 py-2 rounded-lg font-bold ${editLang === 'en' ? 'bg-blue-600 text-white shadow-md' : 'bg-gray-100 text-gray-600'}`}>
                  🇬🇧 EN
                </button>
              </div>

              <div className="space-y-4">
                <Input
                  label={`Menü Adı (${editLang.toUpperCase()}) *`}
                  value={editLang === 'tr' ? editingItem.labelTR : editingItem.labelEN}
                  onChange={(val) => setEditingItem({
                    ...editingItem,
                    [editLang === 'tr' ? 'labelTR' : 'labelEN']: val
                  })}
                />

                <Input
                  label="Link (URL) *"
                  value={editingItem.href}
                  onChange={(val) => setEditingItem({ ...editingItem, href: val })}
                  placeholder="/sayfa-url veya https://..."
                />

                <Select
                  label="Üst Menü"
                  value={editingItem.parentId || ''}
                  onChange={(val) => setEditingItem({ ...editingItem, parentId: val || null })}
                  options={[
                    { label: 'Ana Menü (Üst Seviye)', value: '' },
                    ...getParentMenuItems()
                      .filter(item => item.id !== editingItem.id)
                      .map(item => ({ label: item.labelTR, value: item.id }))
                  ]}
                />

                <Select
                  label="Konum"
                  value={editingItem.position}
                  onChange={(val) => setEditingItem({ ...editingItem, position: val as 'header' | 'footer' })}
                  options={[
                    { label: 'Üst Menü (Header)', value: 'header' },
                    { label: 'Alt Menü (Footer)', value: 'footer' }
                  ]}
                />

                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={editingItem.isActive}
                        onChange={(e) => setEditingItem({ ...editingItem, isActive: e.target.checked })}
                        className="w-4 h-4 text-blue-600 rounded focus:ring-blue-500"
                      />
                      <span className="text-sm font-medium text-gray-700">Aktif</span>
                    </label>
                  </div>
                  <div>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={editingItem.mobileVisible}
                        onChange={(e) => setEditingItem({ ...editingItem, mobileVisible: e.target.checked })}
                        className="w-4 h-4 text-blue-600 rounded focus:ring-blue-500"
                      />
                      <span className="text-sm font-medium text-gray-700">Mobilde Görünür</span>
                    </label>
                  </div>
                </div>
              </div>

              <div className="flex gap-4 mt-8">
                <Button onClick={saveEditingItem}>
                  Kaydet
                </Button>
                <Button onClick={() => { setShowEditForm(false); setEditingItem(null); }} variant="secondary">
                  İptal
                </Button>
              </div>
            </div>
          </div>
        )}

        <div className="flex gap-4">
          <Button onClick={handleSave} disabled={saving}>
            {saving ? 'Kaydediliyor...' : 'Tüm Değişiklikleri Kaydet'}
          </Button>
        </div>
      </div>
    </AdminLayout>
  );
};

export default NavbarEditor;
